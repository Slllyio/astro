      "type": "object"
    },
    "ChartInput": {
      "additionalProperties": false,
      "description": "User-supplied birth-data envelope.\n\nFormat conventions:\n    - `dob` is ISO date `YYYY-MM-DD`\n    - `time` is 24-hour `HH:MM`\n    - `tz` is signed offset `\u00b1HH:MM` (the project does NOT accept tz-database names)\n    - `lat`, `lon` in decimal degrees; negatives are South / West",
      "properties": {
        "dob": {
          "title": "Dob",
          "type": "string"
        },
        "time": {
          "title": "Time",
          "type": "string"
        },
        "tz": {
          "title": "Tz",
          "type": "string"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "dob",
        "time",
        "tz",
        "lat",
        "lon"
      ],
      "title": "ChartInput",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "A single doctrine-source citation attached to a Finding by Tier-3 RAG.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "passage": {
          "title": "Passage",
          "type": "string"
        },
        "relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance",
          "type": "number"
        },
        "knowledge_doc_id": {
          "title": "Knowledge Doc Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "passage",
        "relevance",
        "knowledge_doc_id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ConfidenceScore": {
      "additionalProperties": false,
      "description": "3-vote rule confidence envelope.\n\n`votes` is a fixed-key dict {house, lord, karaka} -> bool indicating which\nof the three classical evidence pillars agree with the finding. `score`\nis a [0,1] aggregation; `band` is the human-readable bucket.",
      "properties": {
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "votes": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Votes",
          "type": "object"
        },
        "band": {
          "enum": [
            "indicative_only",
            "low",
            "medium",
            "high",
            "very_strong"
          ],
          "title": "Band",
          "type": "string"
        }
      },
      "required": [
        "score",
        "votes",
        "band"
      ],
      "title": "ConfidenceScore",
      "type": "object"
    },
    "ConsensusScore": {
      "additionalProperties": false,
      "description": "Cross-source agreement scored by `consensus_scoring.py` (Tier-3).",
      "properties": {
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "sources_agreeing": {
          "minimum": 0,
          "title": "Sources Agreeing",
          "type": "integer"
        },
        "sources_total": {
          "minimum": 0,
          "title": "Sources Total",
          "type": "integer"
        },
        "low_consensus_flag": {
          "title": "Low Consensus Flag",
          "type": "boolean"
        }
      },
      "required": [
        "score",
        "sources_agreeing",
        "sources_total",
        "low_consensus_flag"
      ],
      "title": "ConsensusScore",
      "type": "object"
    },
    "Contradiction": {
      "additionalProperties": false,
      "description": "Cross-finding disagreement detected by `contradiction_detector.py`.\n\n`severity` `\"soft\"` means the directions disagree but both findings stand;\n`\"hard\"` means at least one finding must yield. `suggested_arbitration`\nis descriptive only (spec Section 14: never picks a winner).",
      "properties": {
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Finding Ids",
          "type": "array"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "enum": [
            "soft",
            "hard"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_arbitration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Arbitration"
        }
      },
      "required": [
        "finding_ids",
        "domain",
        "description",
        "severity"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "Dispute": {
      "additionalProperties": false,
      "description": "Report-only doctrine variance surfaced by `dispute_surfacing.py`.\n\nBy design carries NO `is_correct` / `recommended_side` / `engine_preferred`\nfield (spec Section 14, Tier-3 methodology commitments).",
