    "Finding": {
      "additionalProperties": false,
      "description": "The universal output unit emitted by every engine module.\n\nA Finding represents one judgment: a karaka identification, a yoga\ndetection, an MD check-step result, a domain promise/trigger/affliction.\nTier-3 enrichments (citations, consensus, dispute, robustness,\ncontradicts_finding_ids) are inline so consumers never need a JOIN to\ntop-level enrichment tables.\n\nID grammar (stable across runs; enumeration-based IDs are forbidden):\n    - `seq_<N>.<scope>.<rule_slug>`         e.g. `seq_5.md_3.step_05_rashi_depositor`\n    - `primitive.<module>.<rule_slug>`      e.g. `primitive.karakas.atmakaraka`\n    - `foundation.<module>.<rule_slug>`     e.g. `foundation.argala.7th_house_argala`\n    - `practitioner.<module>.<rule_slug>`   e.g. `practitioner.mks.saturn_in_1`\n    - `domain.<name>.<rule_slug>`           e.g. `domain.marriage.7l_dasha_window`",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "source_sequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Sequence"
        },
        "classification": {
          "enum": [
            "promise",
            "trigger",
            "affliction",
            "yoga",
            "primitive"
          ],
          "title": "Classification",
          "type": "string"
        },
        "direction": {
          "enum": [
            "positive",
            "negative",
            "neutral",
            "mixed"
          ],
          "title": "Direction",
          "type": "string"
        },
        "verdict": {
          "maxLength": 140,
          "title": "Verdict",
          "type": "string"
        },
        "verdict_language": {
          "const": "en",
          "default": "en",
          "title": "Verdict Language",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceScore"
        },
        "enrichment_level": {
          "default": 0,
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Enrichment Level",
          "type": "integer"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "consensus": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsensusScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consensus_status": {
          "default": "not_computed",
          "enum": [
            "not_computed",
            "no_agreement",
            "computed"
          ],
          "title": "Consensus Status",
          "type": "string"
        },
        "dispute": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dispute"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "robustness": {
          "anyOf": [
            {
              "$ref": "#/$defs/RobustnessScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contradicts_finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contradicts Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rule",
        "source_sequence",
        "classification",
        "direction",
        "verdict",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
