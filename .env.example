# Copy to `.env` (gitignored) and fill in real values for local dev.
# Production deployments should set these via the platform's secret manager,
# not via .env files.

# --- Environment marker ---
# One of: dev | staging | prod. Local dev defaults to "dev"; staging and
# prod MUST set this explicitly so the secret-key validator can fail loudly
# when a deploy ships with the placeholder SECRET_KEY below.
ENVIRONMENT=dev

# --- Database ---
# Default: ./astro.db (SQLite with WAL). Override for Postgres:
#   DATABASE_URL=postgresql://user:pass@host/astro_db
# The `postgresql://` prefix is auto-rewritten to `postgresql+asyncpg://`.
DATABASE_URL=sqlite+aiosqlite:///./astro.db

# --- Daemon ---
DAEMON_ENABLED=true
DAEMON_CHECK_INTERVAL_SECONDS=3600
TRANSIT_ORB_DEGREES=3.0

# --- Auth ---
# Used to sign JWTs AND encrypt the OAuth state cookie. Generate a fresh value
# for each environment; >=32 bytes recommended:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=604800   # 7 days

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Choose "Web application" type. Add the redirect URI below to its
# "Authorized redirect URIs" list. Leave blank to disable Google login
# (the /auth/google/* routes will return 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Rate limits (requests per minute) ---
RATE_LIMIT_PROFILES_PER_MINUTE=30
RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=60
RATE_LIMIT_AUTH_CALLBACK_PER_MINUTE=10

# --- Local LLM (report/explain, insights, ask, ai-interpret) ---
# Free, private, local-only narrative surfaces served by Ollama — the Anthropic key is
# never spent by these routes. Requires `ollama serve` running locally with the model
# pulled/created (see docs/raman_saab/ for the fine-tuned astro-analyst build steps).
# Leave both false/default to serve the report's own deterministic prose instead (no
# LLM call, no Ollama dependency) — the app works either way.
REPORT_LLM_ENABLED=false
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:1.5b
# NOTE: OLLAMA_MODEL is the FAST model for high-frequency paths (daily summaries etc.).
# The report's narrative surfaces use REPORT_LLM_MODEL below instead — don't point this
# one at a big model or those paths slow down badly.

# The report narrative model. Measured head-to-head 2026-08-03 on 34 held-out rows, scored
# by the same guard the serving path uses:
#     citation-clean   gemma4:12b (stock) 85.3% | astro-analyst LoRA 44.1% | Claude 91.2%
#     guard / crisp    88.2% / 70.6%            | 73.5% / 47.1%           | 100% / 100%
# The stock 12B beats the fine-tuned 1.5B on every axis, including the voice and crispness
# the LoRA was built to teach, for ~4s more per answer (11.6s vs 7.6s) and the same $0
# local cost. The 1.5B is capacity-limited for citation precision across ~20 facts.
# Leave blank to fall through to OLLAMA_MODEL (the old behaviour).
REPORT_LLM_MODEL=gemma4:12b
# REQUIRED for a reasoning model. gemma4:12b advertises "thinking"; on a ~3.1k-token
# evidence prompt it otherwise spends its ENTIRE budget thinking and returns an EMPTY
# response, which the client raises as OllamaUnavailable — silently degrading every answer
# to deterministic prose while the app still looks healthy. Harmless on plain models.
REPORT_LLM_THINK=false
# Evidence prompts run ~3.1k tokens; Ollama's 4k default leaves no room to answer.
REPORT_LLM_NUM_CTX=8192
REPORT_LLM_TIMEOUT_SECONDS=120

# Optional: Hindi translation of the LLM surfaces above (lang="hi" on the birth-details
# page) uses OLLAMA_MODEL by default too — but a small model fine-tuned only on English
# chart analysis (like astro-analyst) reliably CANNOT produce Hindi at all; it's a
# capability gap, not a bug, and the app safely serves English with an honest note when
# this happens. To get real Hindi output, point this at a larger general-purpose local
# model that actually handles Hindi (tested working: gemma4:12b) — live-tested 2026-07-29:
# correct output, but slow (~130s+ per full explanation) and, on a machine already busy
# with other services, can intermittently fail outright (empty response) under memory/GPU
# pressure. Leave blank to skip Hindi LLM translation entirely and always serve English.
# OLLAMA_MODEL_TRANSLATE=gemma4:12b
# OLLAMA_TRANSLATE_TIMEOUT_SECONDS=180
