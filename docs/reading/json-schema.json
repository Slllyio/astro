        }
      },
      "required": [
        "rule"
      ],
      "title": "Dispute",
      "type": "object"
    },
    "DoctrineConfig": {
      "additionalProperties": false,
      "description": "Records the doctrine variant chosen for THIS reading.\n\nEvery default value mirrors the locked decision in\n`docs/doctrine-decisions.md` (D-1 through D-16). When a reading is\nemitted, this block lets downstream consumers verify exactly which\ndoctrine variants produced it. Configurable per-chart but with these\ndocumented defaults.\n\nDefaults track lockfile revision 1 (2026-05-27).",
      "properties": {
        "karaka_mode": {
          "default": 8,
          "enum": [
            7,
            8
          ],
          "title": "Karaka Mode",
          "type": "integer"
        },
        "arudha_exception": {
          "default": "1_7_to_10",
          "enum": [
            "1_7_to_10",
            "none"
          ],
          "title": "Arudha Exception",
          "type": "string"
        },
        "vimsopaka_scheme": {
          "default": "shodashavarga",
          "enum": [
            "shodashavarga",
            "saptavarga",
            "dashavarga"
          ],
          "title": "Vimsopaka Scheme",
          "type": "string"
        },
        "ishta_formula": {
          "default": "bphs_47_3",
          "enum": [
            "bphs_47_3",
            "phaladeepika_6"
          ],
          "title": "Ishta Formula",
          "type": "string"
        },
        "bhava_chalit_system": {
          "default": "sripati",
          "enum": [
            "sripati",
            "porphyry"
          ],
          "title": "Bhava Chalit System",
          "type": "string"
        },
        "karaka_triangulation_reading": {
          "default": "sanjay_rath",
          "enum": [
            "sanjay_rath",
            "bphs_classical"
          ],
          "title": "Karaka Triangulation Reading",
          "type": "string"
        },
        "neech_bhanga_rule": {
          "default": "bphs_39_10",
          "enum": [
            "bphs_39_10",
            "alt_1",
            "alt_2",
            "alt_3"
          ],
          "title": "Neech Bhanga Rule",
          "type": "string"
        },
        "kala_sarpa_definition": {
          "default": "strict_180_rahu_leading",
          "enum": [
            "strict_180_rahu_leading",
            "loose",
            "partial"
          ],
          "title": "Kala Sarpa Definition",
          "type": "string"
        },
        "graha_yuddha_winner": {
          "default": "northern_latitude",
          "enum": [
            "northern_latitude",
            "size",
            "brightness"
          ],
          "title": "Graha Yuddha Winner",
          "type": "string"
        },
        "consensus_min_sources": {
          "default": 3,
          "minimum": 0,
          "title": "Consensus Min Sources",
          "type": "integer"
        },
        "consensus_agreement_threshold": {
          "default": 0.66,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Consensus Agreement Threshold",
          "type": "number"
        }
      },
      "title": "DoctrineConfig",
      "type": "object"
    },
    "DomainReading": {
