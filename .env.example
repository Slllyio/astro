# Copy to `.env` (gitignored) and fill in real values for local dev.
# Production deployments should set these via the platform's secret manager,
# not via .env files.

# --- Database ---
# Default: ./astro.db (SQLite with WAL). Override for Postgres:
#   DATABASE_URL=postgresql://user:pass@host/astro_db
# The `postgresql://` prefix is auto-rewritten to `postgresql+asyncpg://`.
DATABASE_URL=sqlite+aiosqlite:///./astro.db

# --- Daemon ---
DAEMON_ENABLED=true
DAEMON_CHECK_INTERVAL_SECONDS=3600
TRANSIT_ORB_DEGREES=3.0

# --- Auth ---
# Used to sign JWTs AND encrypt the OAuth state cookie. Generate a fresh value
# for each environment; >=32 bytes recommended:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=604800   # 7 days

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Choose "Web application" type. Add the redirect URI below to its
# "Authorized redirect URIs" list. Leave blank to disable Google login
# (the /auth/google/* routes will return 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Rate limits (requests per minute) ---
RATE_LIMIT_PROFILES_PER_MINUTE=30
RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=60
RATE_LIMIT_AUTH_CALLBACK_PER_MINUTE=10
