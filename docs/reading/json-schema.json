          },
          "title": "Checks",
          "type": "object"
        },
        "overall_verdict": {
          "$ref": "#/$defs/Finding"
        }
      },
      "required": [
        "md_lord",
        "start_jd",
        "end_jd",
        "start_date",
        "end_date",
        "age_at_start",
        "age_at_end",
        "is_current",
        "is_past",
        "is_future",
        "checks",
