  "additionalProperties": false,
  "description": "Top-level JSON contract.\n\nThe 9-key shape mirrors the pipeline stages 1\u20138 (spec Section 6):\n\n- `meta`           \u2014 engine + chart envelope, doctrine echo\n- `chart`          \u2014 Stage 1 natal raw\n- `primitives`     \u2014 Stage 2 Tier-0 outputs\n- `foundations`    \u2014 Stage 3 Tier-1 outputs\n- `practitioner`   \u2014 Stage 4 Tier-2 outputs\n- `sequences`      \u2014 Stage 5 4 named sequence results\n- `domains`        \u2014 Stage 6 6 named domain readings\n- `contradictions` \u2014 Stage 8.3 cross-finding disagreements\n- `warnings`       \u2014 engine-level diagnostics (non-fatal)",
  "properties": {
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "chart": {
      "$ref": "#/$defs/ChartBlock"
    },
    "primitives": {
      "$ref": "#/$defs/PrimitivesBlock"
    },
    "foundations": {
      "$ref": "#/$defs/FoundationsBlock"
    },
    "practitioner": {
      "$ref": "#/$defs/PractitionerBlock"
    },
    "sequences": {
      "$ref": "#/$defs/SequencesBlock"
    },
    "domains": {
      "$ref": "#/$defs/DomainsBlock"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "chart",
    "primitives",
    "foundations",
    "practitioner",
    "sequences",
    "domains"
  ],
  "title": "ReadingOutput",
  "type": "object"
