      ],
      "title": "MDJudgment",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Engine + chart-input metadata accompanying every reading.\n\n`schema_version` is the public stable lock; bump to 1.1.0 for additive\nfields, 2.0.0 for breaking changes. `stability` is `\"experimental\"`\nuntil the first non-engine downstream consumer ships, then `\"beta\"`,\nthen `\"stable\"`.\n\n`doctrine_config` echoes the 16 lockfile decisions so every emitted\nreading is self-describing (per spec Section 6, design choices).",
      "properties": {
        "schema_version": {
          "default": "1.1.0",
          "enum": [
            "1.0.0",
            "1.1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "stability": {
          "default": "experimental",
          "enum": [
            "experimental",
            "beta",
            "stable"
          ],
          "title": "Stability",
          "type": "string"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "swiss_ephemeris_version": {
          "title": "Swiss Ephemeris Version",
          "type": "string"
        },
        "python_version": {
